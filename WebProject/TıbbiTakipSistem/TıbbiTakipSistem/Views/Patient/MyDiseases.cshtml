@model IEnumerable<TıbbiTakipSistem.Models.Disease>

@{
    ViewData["Title"] = "Hastalıklarım";
}

<div class="container mt-4">
    <h2 class="mb-4">Hastalıklarım</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz kayıtlı hastalığınız bulunmamaktadır.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var disease in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@disease.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                Tanı Tarihi: @disease.DiagnosisDate.ToShortDateString()
                            </h6>
                            <p class="card-text">@disease.Description</p>
                            @if (disease.Doctor != null)
                            {
                                <p class="card-text">
                                    <small class="text-muted">
                                        Doktor: Dr. @disease.Doctor.Name @disease.Doctor.Surname
                                        @if (!string.IsNullOrEmpty(disease.Doctor.Specialty))
                                        {
                                            <span>(@disease.Doctor.Specialty)</span>
                                        }
                                    </small>
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div> 